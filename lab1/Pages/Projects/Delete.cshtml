@page "{id:int}"
@model lab1.Pages.Projects.DeleteModel

@{
    ViewData["Title"] = "Delete Project";
}

<h1>@ViewData["Title"]</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="alert alert-danger">
    <p>Are you sure you want to delete the project <strong>@Model.Project.Name</strong>?</p>
    @if (Model.Project.EmployeeProjects.Any())
    {
        <p class="text-warning">This project has @Model.Project.EmployeeProjects.Count assigned employee(s). Deleting it will remove all assignments.</p>
    }
</div>

<form method="post" class="form-inline">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
