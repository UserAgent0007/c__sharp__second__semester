@page "{id:int}"
@model lab1.Pages.Projects.DetailsModel

@{
    ViewData["Title"] = "Project Details";
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <p><strong>Name:</strong> @Model.Project.Name</p>
        <p><strong>Description:</strong> @Model.Project.Description</p>

        @if (Model.Project.EmployeeProjects.Any())
        {
            <h4 class="mt-4">Assigned Employees</h4>
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Position</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Duration (days)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ep in Model.Project.EmployeeProjects)
                    {
                        var duration = ep.EndDate.DayNumber - ep.StartDate.DayNumber + 1;
                        <tr>
                            <td>@ep.Employee?.FirstName @ep.Employee?.LastName</td>
                            <td>@ep.Employee?.Position?.Name</td>
                            <td>@ep.StartDate.ToString("dd/MM/yyyy")</td>
                            <td>@ep.EndDate.ToString("dd/MM/yyyy")</td>
                            <td>@duration days</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mt-3">No employees assigned yet.</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Project.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Delete" asp-route-id="@Model.Project.Id" class="btn btn-danger">Delete</a>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</div>
