@page "{id:int}"
@model lab1.Pages.Positions.DetailsModel

@{
    ViewData["Title"] = "Position Details";
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <p><strong>Name:</strong> @Model.Position.Name</p>
        <p><strong>Salary:</strong> $@Model.Position.Salary.ToString("N2")</p>

        @if (Model.Position.Employees.Any())
        {
            <h4 class="mt-4">Employees</h4>
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model.Position.Employees)
                    {
                        <tr>
                            <td>@employee.FirstName</td>
                            <td>@employee.LastName</td>
                            <td>@employee.Address</td>
                            <td>
                                <a asp-page="/Employees/Details" asp-route-id="@employee.Id" class="btn btn-info btn-sm">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mt-3">No employees with this position.</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Position.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Delete" asp-route-id="@Model.Position.Id" class="btn btn-danger">Delete</a>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</div>
