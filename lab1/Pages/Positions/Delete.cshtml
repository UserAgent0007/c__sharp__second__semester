@page "{id:int}"
@model lab1.Pages.Positions.DeleteModel

@{
    ViewData["Title"] = "Delete Position";
}

<h1>@ViewData["Title"]</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="alert alert-danger">
    <p>Are you sure you want to delete the position <strong>@Model.Position.Name</strong>?</p>
    @if (Model.Position.Employees.Any())
    {
        <p class="text-warning">This position has @Model.Position.Employees.Count employee(s). Please reassign them before deleting.</p>
    }
</div>

<form method="post" class="form-inline">
    <button type="submit" class="btn btn-danger" disabled="@Model.Position.Employees.Any()">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
