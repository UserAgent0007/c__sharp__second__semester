@page "{id:int}"
@model lab1.Pages.Employees.DetailsModel

@{
    ViewData["Title"] = "Employee Details";
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <p><strong>First Name:</strong> @Model.Employee.FirstName</p>
        <p><strong>Last Name:</strong> @Model.Employee.LastName</p>
        <p><strong>Middle Name:</strong> @Model.Employee.MiddleName</p>
        <p><strong>Position:</strong> @Model.Employee.Position?.Name</p>
        <p><strong>Address:</strong> @Model.Employee.Address</p>
        <p><strong>Characteristic:</strong> @Model.Employee.Characteristic</p>

        <h4 class="mt-4">Projects</h4>
        @if (Model.Employee.EmployeeProjects.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Project Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Duration (days)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ep in Model.Employee.EmployeeProjects)
                        {
                            var duration = ep.EndDate.DayNumber - ep.StartDate.DayNumber + 1;
                            <tr>
                                <td><strong>@ep.Project?.Name</strong></td>
                                <td>@ep.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@ep.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@duration days</td>
                                <td>
                                    <a asp-page="/EmployeeProjects/Edit" asp-route-id="@ep.EmployeeProjectId" class="btn btn-sm btn-warning">Edit</a>
                                    <a asp-page="/EmployeeProjects/Delete" asp-route-id="@ep.EmployeeProjectId" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No projects assigned yet.</p>
        }
        <div class="mt-2">
            <a asp-page="/EmployeeProjects/Assign" asp-route-employeeId="@Model.Employee.Id" class="btn btn-sm btn-success">Assign Project</a>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Employee.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Delete" asp-route-id="@Model.Employee.Id" class="btn btn-danger">Delete</a>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</div>
