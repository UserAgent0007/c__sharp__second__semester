@page "/projects/{Id:int}"
@inject ProjectService Service

<PageTitle>Project Details</PageTitle>

<h1>Project Details</h1>

@if (loading)
{
    <p><em>Завантаження...</em></p>
}
else if (project == null)
{
    <div class="alert alert-warning">Проєкт не знайдено.</div>
    <a href="/projects" class="btn btn-secondary">Back</a>
}
else
{
    <div class="card">
        <div class="card-body">
            <p><strong>Name:</strong> @project.Name</p>
            <p><strong>Description:</strong> @project.Description</p>

            @if (project.EmployeeProjects.Any())
            {
                <h4 class="mt-4">Assigned Employees</h4>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Position</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Duration (days)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ep in project.EmployeeProjects)
                        {
                            var duration = ep.EndDate.DayNumber - ep.StartDate.DayNumber + 1;
                            <tr>
                                <td>@ep.Employee?.FirstName @ep.Employee?.LastName</td>
                                <td>@ep.Employee?.Position?.Name</td>
                                <td>@ep.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@ep.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@duration days</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mt-3">No employees assigned yet.</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a href="/projects/edit/@project.Id" class="btn btn-warning">Edit</a>
        <a href="/projects/delete/@project.Id" class="btn btn-danger">Delete</a>
        <a href="/projects" class="btn btn-secondary">Back</a>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Project? project;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        project = await Service.GetByIdAsync(Id);
        loading = false;
    }
}
