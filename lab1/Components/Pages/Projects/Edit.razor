@page "/projects/edit/{Id:int}"
@inject ProjectService Service
@inject NavigationManager Nav

<PageTitle>Edit Project</PageTitle>

<h1>Edit Project</h1>

@if (loading)
{
    <p><em>Завантаження...</em></p>
}
else if (input == null)
{
    <div class="alert alert-warning">Проєкт не знайдено.</div>
    <a href="/projects" class="btn btn-secondary">Back</a>
}
else
{
    <EditForm Model="input" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />
        @if (error != null)
        {
            <div class="text-danger mb-3">@error</div>
        }

        <div class="form-group mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="input.Name" />
            <ValidationMessage For="() => input.Name" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="input.Description" />
            <ValidationMessage For="() => input.Description" class="text-danger" />
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Update</button>
            <a href="/projects" class="btn btn-secondary">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProjectInput? input;
    private string? error;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var project = await Service.GetByIdAsync(Id);
        input = project == null ? null : new ProjectInput { Name = project.Name, Description = project.Description };
        loading = false;
    }

    private async Task SaveAsync()
    {
        error = await Service.UpdateAsync(Id, input!);
        if (error == null)
        {
            Nav.NavigateTo($"/projects/{Id}");
        }
    }
}
