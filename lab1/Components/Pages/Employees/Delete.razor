@page "/employees/delete/{Id:int}"
@inject EmployeeService Service
@inject NavigationManager Nav

<PageTitle>Delete Employee</PageTitle>

<h1>Delete Employee</h1>

@if (loading)
{
    <p><em>Завантаження...</em></p>
}
else if (employee == null)
{
    <div class="alert alert-warning">Працівника не знайдено.</div>
    <a href="/employees" class="btn btn-secondary">Back</a>
}
else
{
    if (error != null)
    {
        <div class="text-danger mb-3">@error</div>
    }

    <div class="alert alert-danger">
        <p>Are you sure you want to delete <strong>@employee.FirstName @employee.LastName</strong>?</p>
    </div>

    <button type="button" class="btn btn-danger" @onclick="DeleteAsync">Delete</button>
    <a href="/employees" class="btn btn-secondary">Cancel</a>
}

@code {
    [Parameter] public int Id { get; set; }

    private Employee? employee;
    private string? error;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        employee = await Service.GetByIdAsync(Id);
        loading = false;
    }

    private async Task DeleteAsync()
    {
        error = await Service.DeleteAsync(Id);
        if (error == null)
        {
            Nav.NavigateTo("/employees");
        }
    }
}
