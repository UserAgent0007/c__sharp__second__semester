@page "/employees/create"
@inject EmployeeService Service
@inject PositionService PositionsService
@inject NavigationManager Nav

<PageTitle>Create Employee</PageTitle>

<h1>Create Employee</h1>

@if (positions == null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <EditForm Model="input" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />
        @if (error != null)
        {
            <div class="text-danger mb-3">@error</div>
        }

        <div class="form-group mb-3">
            <label class="form-label">First name</label>
            <InputText class="form-control" @bind-Value="input.FirstName" />
            <ValidationMessage For="() => input.FirstName" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Last name</label>
            <InputText class="form-control" @bind-Value="input.LastName" />
            <ValidationMessage For="() => input.LastName" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Middle name</label>
            <InputText class="form-control" @bind-Value="input.MiddleName" />
            <ValidationMessage For="() => input.MiddleName" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Position</label>
            <InputSelect class="form-control" @bind-Value="input.PositionId">
                <option value="">-- Select Position --</option>
                @foreach (var p in positions)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="() => input.PositionId" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Address</label>
            <InputText class="form-control" @bind-Value="input.Address" />
            <ValidationMessage For="() => input.Address" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Characteristic</label>
            <InputTextArea class="form-control" @bind-Value="input.Characteristic" />
            <ValidationMessage For="() => input.Characteristic" class="text-danger" />
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Create</button>
            <a href="/employees" class="btn btn-secondary">Back</a>
        </div>
    </EditForm>
}

@code {
    private readonly EmployeeInput input = new();
    private List<Position>? positions;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        positions = await PositionsService.GetListAsync();
    }

    private async Task SaveAsync()
    {
        error = await Service.CreateAsync(input);
        if (error == null)
        {
            Nav.NavigateTo("/employees");
        }
    }
}
