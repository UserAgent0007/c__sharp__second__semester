@page "/employees"
@inject EmployeeService Service

<PageTitle>Employees</PageTitle>

<h1>Employees</h1>

<p>
    <a href="/employees/create" class="btn btn-primary">Create New</a>
</p>

@if (items == null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Middle Name</th>
                <th>Position</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.MiddleName</td>
                    <td>@item.Position?.Name</td>
                    <td>@item.Address</td>
                    <td>
                        <a href="/employees/@item.Id" class="btn btn-info btn-sm">Details</a>
                        <a href="/employees/edit/@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a href="/employees/delete/@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Employee>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await Service.GetAllAsync();
    }
}
