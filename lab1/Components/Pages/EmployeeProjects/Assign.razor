@page "/employeeprojects/assign/{EmployeeId:int}"
@inject EmployeeService EmployeesService
@inject EmployeeProjectService Service
@inject NavigationManager Nav

<PageTitle>Assign Project</PageTitle>

<h1>Assign Project</h1>

@if (loading)
{
    <p><em>Завантаження...</em></p>
}
else if (employee == null)
{
    <div class="alert alert-warning">Працівника не знайдено.</div>
    <a href="/employees" class="btn btn-secondary">Back</a>
}
else
{
    <p class="lead">Employee: <strong>@employee.FirstName @employee.LastName</strong></p>

    if (!availableProjects.Any())
    {
        <div class="alert alert-info">
            All available projects have been assigned to this employee.
            <a href="/employees/@EmployeeId" class="btn btn-sm btn-secondary">Back</a>
        </div>
    }
    else
    {
        <EditForm Model="input" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            @if (error != null)
            {
                <div class="text-danger mb-3">@error</div>
            }

            <div class="form-group mb-3">
                <label class="form-label">Select Project</label>
                <InputSelect class="form-control" @bind-Value="input.ProjectId">
                    <option value="">-- Choose a project --</option>
                    @foreach (var project in availableProjects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => input.ProjectId" class="text-danger" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Start Date</label>
                <InputDate TValue="DateOnly"
                    class="form-control"
                    Value="input.StartDate"
                    ValueExpression="() => input.StartDate"
                    ValueChanged="@((DateOnly value) => OnStartDateChanged(value))" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">End Date</label>
                <InputDate class="form-control" @bind-Value="input.EndDate" />
                <ValidationMessage For="() => input.EndDate" class="text-danger" />
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Assign Project</button>
                <a href="/employees/@EmployeeId" class="btn btn-secondary">Cancel</a>
            </div>
        </EditForm>
    }
}

@code {
    [Parameter] public int EmployeeId { get; set; }

    private Employee? employee;
    private List<Project> availableProjects = new();
    private readonly AssignInput input = new();
    private string? error;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        employee = await EmployeesService.GetByIdAsync(EmployeeId);
        if (employee != null)
        {
            availableProjects = await Service.GetAvailableProjectsAsync(EmployeeId);
        }
        loading = false;
    }

    // Якщо дата початку пізніша за дату завершення, підтягуємо дату завершення
    private void OnStartDateChanged(DateOnly value)
    {
        input.StartDate = value;
        if (input.EndDate < value)
        {
            input.EndDate = value;
        }
    }

    private async Task SaveAsync()
    {
        error = await Service.AssignAsync(EmployeeId, input);
        if (error == null)
        {
            Nav.NavigateTo($"/employees/{EmployeeId}");
        }
    }
}
