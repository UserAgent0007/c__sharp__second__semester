@page "/employeeprojects/edit/{Id:int}"
@inject EmployeeProjectService Service
@inject NavigationManager Nav

<PageTitle>Edit Project Assignment</PageTitle>

<h1>Edit Project Assignment</h1>

@if (loading)
{
    <p><em>Завантаження...</em></p>
}
else if (assignment == null || input == null)
{
    <div class="alert alert-warning">Призначення не знайдено.</div>
    <a href="/employees" class="btn btn-secondary">Back</a>
}
else
{
    <p class="lead">Employee: <strong>@assignment.Employee?.FirstName @assignment.Employee?.LastName</strong></p>
    <p>Project: <strong>@assignment.Project?.Name</strong></p>

    <EditForm Model="input" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />
        @if (error != null)
        {
            <div class="text-danger mb-3">@error</div>
        }

        <div class="form-group mb-3">
            <label class="form-label">Start Date</label>
            <InputDate class="form-control" @bind-Value="input.StartDate" />
            <ValidationMessage For="() => input.StartDate" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">End Date</label>
            <InputDate class="form-control" @bind-Value="input.EndDate" />
            <ValidationMessage For="() => input.EndDate" class="text-danger" />
        </div>

        @if (input.EndDate >= input.StartDate)
        {
            <div class="alert alert-info mt-3">
                <strong>Duration:</strong> @(input.EndDate.DayNumber - input.StartDate.DayNumber + 1) days
            </div>
        }

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/employees/@assignment.EmployeeId" class="btn btn-secondary">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private EmployeeProject? assignment;
    private AssignmentDatesInput? input;
    private string? error;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        assignment = await Service.GetByIdAsync(Id);
        input = assignment == null
            ? null
            : new AssignmentDatesInput { StartDate = assignment.StartDate, EndDate = assignment.EndDate };
        loading = false;
    }

    private async Task SaveAsync()
    {
        error = await Service.UpdateAsync(Id, input!);
        if (error == null)
        {
            Nav.NavigateTo($"/employees/{assignment!.EmployeeId}");
        }
    }
}
