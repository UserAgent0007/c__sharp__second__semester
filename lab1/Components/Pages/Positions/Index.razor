@page "/positions"
@inject PositionService Service

<PageTitle>Positions</PageTitle>

<h1>Positions</h1>

<p>
    <a href="/positions/create" class="btn btn-primary">Create New</a>
</p>

@if (items == null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Salary</th>
                <th>Employees</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>$@item.Salary.ToString("N2")</td>
                    <td>@item.Employees.Count</td>
                    <td>
                        <a href="/positions/@item.Id" class="btn btn-info btn-sm">Details</a>
                        <a href="/positions/edit/@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a href="/positions/delete/@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Position>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await Service.GetAllAsync();
    }
}
