<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <HeadOutlet @rendermode="RenderModeNoPrerender" />
</head>
<body>
    <Routes @rendermode="RenderModeNoPrerender" />

    <div id="blazor-error-ui" style="display:none; position:fixed; bottom:0; left:0; right:0; padding:.75rem 1.25rem; background:#fff3cd; z-index:1000;">
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <a class="dismiss" style="cursor:pointer; float:right;">&#x1F5D9;</a>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@code {
    // Усі сторінки інтерактивні (Blazor Server). Prerender вимкнено, щоб дані
    // не завантажувались двічі, а форми одразу працювали.
    private static readonly IComponentRenderMode RenderModeNoPrerender =
        new InteractiveServerRenderMode(prerender: false);
}
