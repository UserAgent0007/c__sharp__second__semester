@model lab1.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <p><strong>First Name:</strong> @Model.FirstName</p>
        <p><strong>Last Name:</strong> @Model.LastName</p>
        <p><strong>Middle Name:</strong> @Model.MiddleName</p>
        <p><strong>Position:</strong> @Model.Position?.Name</p>
        <p><strong>Address:</strong> @Model.Address</p>
        <p><strong>Characteristic:</strong> @Model.Characteristic</p>

        <h4 class="mt-4">Projects</h4>
        @if (Model.EmployeeProjects.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Project Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Duration (days)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model.EmployeeProjects)
                        {
                            var duration = (project.EndDate.ToDateTime(TimeOnly.MinValue) - project.StartDate.ToDateTime(TimeOnly.MinValue)).Days + 1;
                            <tr>
                                <td><strong>@project.Project?.Name</strong></td>
                                <td>@project.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@project.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@duration days</td>
                                <td>
                                    <a asp-controller="EmployeeProjects" asp-action="Edit" asp-route-id="@project.EmployeeProjectId" class="btn btn-sm btn-warning">Edit</a>
                                    <form asp-controller="EmployeeProjects" asp-action="Delete" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@project.EmployeeProjectId" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No projects assigned yet.</p>
        }
        <div class="mt-2">
            <a asp-controller="EmployeeProjects" asp-action="Assign" asp-route-employeeId="@Model.Id" class="btn btn-sm btn-success">Assign Project</a>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Employees" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <form asp-controller="Employees" asp-action="Delete" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
    <a asp-controller="Employees" asp-action="Index" class="btn btn-secondary">Back</a>
</div>
