@model lab1.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <p>Are you sure you want to delete <strong>@Model.FirstName @Model.LastName</strong>?</p>
</div>

<form asp-controller="Employees" asp-action="Delete" method="post" class="form-inline">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Employees" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
