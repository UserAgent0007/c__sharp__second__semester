@model lab1.Models.Position

@{
    ViewData["Title"] = "Position Details";
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Salary:</strong> $@Model.Salary.ToString("N2")</p>

        @if (Model.Employees.Any())
        {
            <h4 class="mt-4">Employees</h4>
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model.Employees)
                    {
                        <tr>
                            <td>@employee.FirstName</td>
                            <td>@employee.LastName</td>
                            <td>@employee.Address</td>
                            <td>
                                <a asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id" class="btn btn-info btn-sm">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mt-3">No employees with this position.</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Positions" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <form asp-controller="Positions" asp-action="Delete" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
    <a asp-controller="Positions" asp-action="Index" class="btn btn-secondary">Back</a>
</div>
