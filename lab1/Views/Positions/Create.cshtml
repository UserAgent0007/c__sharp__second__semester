@model lab1.Models.Position

@{
    ViewData["Title"] = "Create Position";
}

<h1>@ViewData["Title"]</h1>

<form asp-controller="Positions" asp-action="Create" method="post" class="form">
    @Html.AntiForgeryToken()
    
    <div class="form-group">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Salary" class="form-label"></label>
        <input asp-for="Salary" class="form-control" type="number" step="0.01" min="0" required />
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-controller="Positions" asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>
